# End-to-end test server: a dedicated database that is reset and reseeded on every run.
NODE_ENV=test
HOST=127.0.0.1
PORT=4100
LOG_LEVEL=warn
DATABASE_URL=postgres://gymflow_app:CHANGE_ME@localhost:5432/gymflow_e2e
MIGRATION_DATABASE_URL=postgres://gymflow_owner:CHANGE_ME@localhost:5432/gymflow_e2e
DATABASE_APP_ROLE=gymflow_app
APP_ORIGIN=http://localhost:3100
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_VALUE
MAIL_TRANSPORT=log
STORAGE_DIR=./var/e2e-storage
FIXED_TODAY=2026-10-07
AUTH_RATE_LIMIT_PER_MINUTE=1000
LOGIN_MAX_FAILURES=50
