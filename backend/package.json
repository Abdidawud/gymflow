{
  "name": "@gymflow/backend",
  "version": "0.1.0",
  "private": true,
  "description": "GymFlow API (/api/v1): staff auth, members, plans, payments, reports \u2014 PostgreSQL.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/server.js",
    "cli": "tsx --env-file-if-exists=.env src/cli.ts",
    "migrate": "npm run cli -- migrate",
    "seed:demo": "npm run cli -- seed:demo",
    "admin:create": "npm run cli -- admin:create",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:serve": "tsx --env-file=.env.e2e src/cli.ts db:reset && tsx --env-file=.env.e2e src/cli.ts seed:demo && tsx --env-file=.env.e2e src/server.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@gymflow/shared": "*",
    "@node-rs/argon2": "^2.2.2",
    "fastify": "^5.12.5",
    "kysely": "^0.29.6",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^24.19.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "eslint": "^9",
    "pino-pretty": "^13.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
