# GymFlow API configuration. Copy to .env for local development.
# Never commit real credentials: .env is git-ignored.

NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info

# The API connects as a least-privileged application role; migrations run as the schema owner.
DATABASE_URL=postgres://gymflow_app:CHANGE_ME@localhost:5432/gymflow
MIGRATION_DATABASE_URL=postgres://gymflow_owner:CHANGE_ME@localhost:5432/gymflow
DATABASE_APP_ROLE=gymflow_app
# DATABASE_SSL=true   # managed PostgreSQL over TLS

# Public origin of the web app (reset links, origin checks). Use https:// in production.
APP_ORIGIN=http://localhost:3000
# Comma-separated extra origins, only if the web app is served from another origin than /api/v1.
# ALLOWED_ORIGINS=
# Path the browser uses to reach the API (the web app proxies /api/v1 to this service).
PUBLIC_API_PATH=/api/v1

# 32+ random characters, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_VALUE
# Defaults to true in production (HTTPS only).
# COOKIE_SECURE=false
# Reverse proxies the API may trust for client IPs: "loopback", a hop count, or addresses.
TRUST_PROXY=loopback

SESSION_MAX_HOURS=12
SESSION_IDLE_MINUTES=30
PASSWORD_RESET_MINUTES=30

# smtp | log (development: prints emails, including reset links) | disabled
MAIL_TRANSPORT=log
# SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=GymFlow <no-reply@example.com>

# Private storage for member photos and the gym logo (back it up with the database).
STORAGE_DIR=./var/storage

# Development/tests only: freeze "today" so the demo data matches the design (Meskerem 27, 2019 E.C.).
# FIXED_TODAY=2026-10-07
