# GymFlow frontend configuration (safe defaults; override in .env.local or the deployment environment).

# "mock" runs an in-browser mock backend with demo data (no server needed).
# Switch to "http" once the GymFlow backend is available.
NEXT_PUBLIC_API_MODE=mock

# Backend base URL for http mode (same-origin path or absolute URL).
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Name of the readable cookie holding the CSRF token echoed in X-CSRF-Token on writes.
NEXT_PUBLIC_CSRF_COOKIE_NAME=gf_csrf

# Mock mode only: "today" in the gym timezone. Defaults to the design fixture date (2026-10-07).
# Use "live" to follow the real Africa/Addis_Ababa date, or a YYYY-MM-DD value.
# NEXT_PUBLIC_MOCK_TODAY=live

# Interface language before anyone picks one: "am" (Amharic, default) or "en".
NEXT_PUBLIC_DEFAULT_LOCALE=am
