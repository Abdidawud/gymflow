# GymFlow web app — public, non-secret defaults (committed). Secrets and the database
# go in .env.local (git-ignored) locally, and in the Vercel project settings in production.

# "http" (default): the real API, served by this app at /api/v1 (backend/), on PostgreSQL.
# "mock": an in-browser demo backend with sample data, no database needed.
NEXT_PUBLIC_API_MODE=http

# Where the browser reaches the API (same origin by default).
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Name of the readable cookie holding the CSRF token echoed in X-CSRF-Token on writes.
NEXT_PUBLIC_CSRF_COOKIE_NAME=gf_csrf

# Interface language before anyone picks one: "am" (Amharic, default) or "en".
NEXT_PUBLIC_DEFAULT_LOCALE=am
