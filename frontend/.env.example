# Copy to .env.local for local development (git-ignored). In production, set these in
# the Vercel project (Settings → Environment Variables). See backend/.env.example for all options.

# --- Database (the API runs inside this app) ---
# The app's connection: least-privileged role; on Neon/Vercel, the pooled URL (DATABASE_URL).
DATABASE_URL=postgres://gymflow_app:CHANGE_ME@localhost:5432/gymflow
# Schema owner, direct connection, for migrations (on Neon: DATABASE_URL_UNPOOLED is used automatically).
MIGRATION_DATABASE_URL=postgres://gymflow_owner:CHANGE_ME@localhost:5432/gymflow
DATABASE_APP_ROLE=gymflow_app

# --- Security ---
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_VALUE
# Public URL of the app. On Vercel it defaults to the production domain.
APP_ORIGIN=http://localhost:3000
# Protects the daily maintenance cron (Vercel sends it as a Bearer token).
# CRON_SECRET=

# --- Email for password recovery ---
# MAIL_TRANSPORT=smtp
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=GymFlow <no-reply@example.com>

# --- Development only ---
# MAIL_TRANSPORT=log            # print emails (with reset links) to the terminal
# FIXED_TODAY=2026-10-07        # freeze "today" to match the demo data
# NEXT_PUBLIC_API_MODE=mock     # demo without a database
